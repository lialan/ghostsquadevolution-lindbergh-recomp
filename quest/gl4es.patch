+// ********* Programs kept on disk *********
+// LIBGL_PROGRAM_CACHE=<folder>: every program built here is saved there as a
+// driver binary, named by a hash of its two shaders' sources, its attribute
+// bindings and the driver's name and version, and loaded from there the next
+// time instead of compiled and linked (which can take a mobile driver 100 ms).
+static const char* prgcache_dir(void)
+{
+    static int inited = 0;
+    static char dir[512];
+    if(!inited) {
+        inited = 1;
+        const char* d = getenv("LIBGL_PROGRAM_CACHE");
+        if(d && *d && hardext.prgbin_n>0) { snprintf(dir, sizeof(dir), "%s", d); mkdir(dir, 0755); }
+    }
+    return dir[0]?dir:NULL;
+}
+static uint64_t prgcache_hash(uint64_t h, const char* p, size_t n)
+{
+    for(size_t i=0; i<n; i++) h = (h ^ (unsigned char)p[i]) * 1099511628211ull;
+    return (h ^ 0xff) * 1099511628211ull;
+}
+static int prgcache_path(char* out, size_t n, GLuint vert, GLuint frag, program_t* attribs)
+{
+    const char* dir = prgcache_dir();
+    shader_t *v = getShader(vert), *f = getShader(frag);
+    if(!dir || !v || !f || !v->source || !f->source) return 0;
+    static uint64_t drv = 0;
+    if(!drv) {
+        LOAD_GLES(glGetString);
+        const char* r = (const char*)gles_glGetString(GL_RENDERER);
+        const char* ver = (const char*)gles_glGetString(GL_VERSION);
+        drv = prgcache_hash(1469598103934665603ull, r?r:"", r?strlen(r):0);
+        drv = prgcache_hash(drv, ver?ver:"", ver?strlen(ver):0);
+        drv = prgcache_hash(drv, "gl4es fpe 1", 11);
+        if(gl4es_mv_shaders) drv = prgcache_hash(drv, "multiview 7", 11);
+        if(gl4es_mv_shaders && getenv("LIBGL_MV_NOCLIP")) drv = prgcache_hash(drv, "noclip", 6);
+    }
+    uint64_t h = prgcache_hash(drv, v->source, strlen(v->source));
+    h = prgcache_hash(h, f->source, strlen(f->source));
+    if(attribs && attribs->attribloc) {
+        attribloc_t *al;
+        kh_foreach_value(attribs->attribloc, al,
+            h = prgcache_hash(h, (const char*)&al->index, sizeof(al->index));
+            h = prgcache_hash(h, al->name, strlen(al->name));
+        );
+    }
+    snprintf(out, n, "%s/f%016llx.bin", dir, (unsigned long long)h);
+    return 1;
+}
+static int prgcache_load(GLuint prog, const char* path)
+{
+    FILE* fl = fopen(path, "rb");
+    if(!fl) return 0;
+    GLenum fmt = 0; long len = 0; void* data = NULL;
+    if(fread(&fmt, sizeof(fmt), 1, fl)==1 && !fseek(fl, 0, SEEK_END) && (len = ftell(fl)-(long)sizeof(fmt))>0
+       && !fseek(fl, sizeof(fmt), SEEK_SET) && (data = malloc(len)) && fread(data, 1, len, fl)!=(size_t)len) {
+        free(data); data = NULL;
+    }
+    fclose(fl);
+    if(!data) return 0;
+    int ok = gl4es_useProgramBinary(prog, len, fmt, data);
+    free(data);
+    return ok;
+}
+static void prgcache_save(GLuint prog, const char* path)
+{
+    int len = 0; GLenum fmt = 0; void* data = NULL;
+    if(!gl4es_getProgramBinary(prog, &len, &fmt, &data) || len<=0) { free(data); return; }
+    char tmp[600];
+    snprintf(tmp, sizeof(tmp), "%s.part", path);
+    FILE* fl = fopen(tmp, "wb");
+    if(fl) {
+        int ok = fwrite(&fmt, sizeof(fmt), 1, fl)==1 && fwrite(data, 1, len, fl)==(size_t)len;
+        if(fclose(fl)==0 && ok) rename(tmp, path); else remove(tmp);
+    }
+    free(data);
+}
+// Compile and link prog from its two attached shaders, whose sources are set -
+// or load it from the cache. Returns the link status; what is the program for
+// the messages.
+static int build_program(GLuint prog, GLuint vert, GLuint frag, program_t* attribs, const char* what)
+{
+    char path[600];
+    int cached = prgcache_path(path, sizeof(path), vert, frag, attribs);
+    if(cached && prgcache_load(prog, path)) return 1;
+    GLint status;
+    GLuint sh[2] = {vert, frag};
+    for(int i=0; i<2; i++) {
+        gl4es_glCompileShader(sh[i]);
+        gl4es_glGetShaderiv(sh[i], GL_COMPILE_STATUS, &status);
+        if(status!=GL_TRUE) {
+            char buff[1000];
+            gl4es_glGetShaderInfoLog(sh[i], 1000, NULL, buff);
+            printf("LIBGL: %s %s shader compile failed: %s\n", what, i?"Fragment":"Vertex", buff);
+            if(globals4es.logshader) printf("source is\n%s\n", getShader(sh[i])->source);
+            return 0;
+        }
+    }
+    gl4es_glLinkProgram(prog);
+    gl4es_glGetProgramiv(prog, GL_LINK_STATUS, &status);
+    if(status!=GL_TRUE) {
+        char buff[1000];
+        gl4es_glGetProgramInfoLog(prog, 1000, NULL, buff);
+        printf("LIBGL: %s link failed: %s\n", what, buff);
+        return 0;
+    }
+    if(cached) prgcache_save(prog, path);
+    return 1;
+}
